                                },
                                "history-data-id": {
                                    "type": "string"
                                },
                                "granularity-period": {
                                    "type": "string",
                                    "enum": [
                                        "pure-ethernet-structure-2-0:GRANULARITY_PERIOD_TYPE_UNKNOWN",
                                        "pure-ethernet-structure-2-0:GRANULARITY_PERIOD_TYPE_PERIOD-15-MIN",
                                        "pure-ethernet-structure-2-0:GRANULARITY_PERIOD_TYPE_PERIOD-24-HOURS",
                                        "pure-ethernet-structure-2-0:GRANULARITY_PERIOD_TYPE_NOT_YET_DEFINED"
                                    ]
